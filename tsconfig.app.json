{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/app",
    "types": [
      "react",
      "react-dom"
    ],
    "jsx": "react-jsx",
    "experimentalDecorators": false,
    "importHelpers": false,
    "paths": {
      "src/*": [
        "./src/*"
      ]
    },
    "moduleResolution": "bundler"
  },
  "files": [
    "src/main.ts"
  ],
  "include": [
    "src/**/*.d.ts"
  ]
}
