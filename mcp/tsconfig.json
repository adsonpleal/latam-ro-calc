{
  // Typecheck config for the MCP server. Kept separate from the root tsconfig so the
  // Angular build never sees these settings — and so the two `paths` entries below
  // apply only here.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "baseUrl": "..",
    "module": "ESNext",
    // The MCP SDK ships subpath exports (@modelcontextprotocol/sdk/server/mcp.js);
    // the root's "node" resolution predates package `exports` and cannot see them.
    "moduleResolution": "bundler",
    "types": ["node"],
    // No "dom": the server has no browser globals, so referencing one should fail
    // here rather than at runtime on the box.
    "lib": ["ES2022"],
    // @types/node declares Symbol.dispose/asyncDispose members that need TS 5.2's
    // esnext.disposable lib; Angular 16 pins us to TS 5.1. We never touch those APIs,
    // so skip typechecking dependency .d.ts files rather than fighting it.
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      // `ng build --configuration production` swaps this file in via angular.json's
      // fileReplacements, which nothing outside the Angular builder applies. Without
      // it the server would run with `production: false`, and CharacterBase's
      // atkSkills/activeSkills/passiveSkills getters would expose dev-only skills the
      // website hides — silently diverging the skill lists that share tokens index into.
      "src/environments/environment": ["src/environments/environment.prod.ts"],
      // The engine imports in the root tsconfig's `baseUrl: "./"` style, e.g.
      // `import { floor } from 'src/app/utils'`.
      "src/*": ["src/*"]
    }
  },
  "include": ["src/**/*.ts"]
}
