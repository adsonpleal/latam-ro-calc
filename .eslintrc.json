{
  "root": true,
  "ignorePatterns": ["projects/**/*"],
  "overrides": [
    {
      "files": ["*.ts"],
      "extends": [
        "eslint:recommended",
        "plugin:@typescript-eslint/recommended",
        "plugin:@angular-eslint/recommended",
        "plugin:@angular-eslint/template/process-inline-templates"
      ],
      "plugins": ["unused-imports"],
      "rules": {
        "@angular-eslint/directive-selector": [
          "error",
          {
            "type": "attribute",
            "prefix": "app",
            "style": "camelCase"
          }
        ],
        "@angular-eslint/component-selector": [
          "error",
          {
            "type": "element",
            "prefix": "app",
            "style": "kebab-case"
          }
        ],
        "@typescript-eslint/no-explicit-any": "off",
        "unused-imports/no-unused-imports": "error",
        "@typescript-eslint/no-unused-vars": "off",
        "unused-imports/no-unused-vars": [
          "warn",
          { "vars": "all", "varsIgnorePattern": "^_", "args": "after-used", "argsIgnorePattern": "^_" }
        ]
      }
    },
    {
      "files": ["src/app/core/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@angular/*", "@angular/**"],
                "message": "src/app/core is the framework-free calculation engine and must not depend on Angular. Keep UI concerns in the component layer."
              },
              {
                "group": ["primeng", "primeng/**", "rxjs", "rxjs/**"],
                "message": "src/app/core is the framework-free calculation engine and must not depend on UI/reactive libraries (PrimeNG, RxJS)."
              },
              {
                "group": ["**/layout/**", "src/app/layout/**"],
                "message": "src/app/core must not import from the UI layer (src/app/layout)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["mcp/**/*.ts"],
      "extends": ["eslint:recommended", "plugin:@typescript-eslint/recommended"],
      "rules": {
        // The server has no decorators for the Angular selector rules to inspect.
        "@angular-eslint/directive-selector": "off",
        "@angular-eslint/component-selector": "off",
        // Matches the project-wide choice: the engine's item/monster records are
        // untyped JSON, so `any` is the honest type at that boundary.
        "@typescript-eslint/no-explicit-any": "off",
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@angular/*", "@angular/**", "primeng", "primeng/**", "rxjs", "rxjs/**"],
                "message": "The MCP server runs in plain Node and bundles the framework-free engine only. Angular/PrimeNG/RxJS imports would break the bundle."
              },
              {
                "group": ["**/layout/**", "src/app/layout/**"],
                "message": "The MCP server must not import from the UI layer (src/app/layout). Port the logic into mcp/src instead."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["*.html"],
      "extends": ["plugin:@angular-eslint/template/recommended", "plugin:@angular-eslint/template/accessibility"],
      "rules": {
        "@angular-eslint/template/elements-content": ["off"],
        "@angular-eslint/template/eqeqeq": ["off"]
      }
    }
  ]
}
