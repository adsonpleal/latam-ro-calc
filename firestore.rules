rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Coleção aposentada. As gravações do "Ajude o simulador" agora vão para o
    // rastreador compartilhado (projeto `issues-latam-tools`, fichas de
    // `tipo: "replay"`), e as 24 que estavam aqui foram migradas para lá com os
    // mesmos ids.
    //
    // O bloco fica de pé, com tudo negado: os documentos continuam aqui como
    // histórico, legíveis só por credencial de administrador, e nenhum cliente
    // antigo em cache consegue mais escrever. O validador abaixo sobrevive como
    // registro do formato que existiu.
    //
    // A leitura sempre foi negada de propósito — assim os envios nunca ficaram
    // atrás de uma URL adivinhável, como acontece com os replays do RagnaRecap.
    // O rastreador preserva isso: a ficha nasce arquivada, e enquanto estiver
    // assim as regras de lá negam o anexo.
    match /replay_submissions/{submissionId} {
      allow read, create, update, delete: if false;
    }

    function isWellFormedSubmission(d) {
      return d.keys().hasOnly([
               'bytes', 'fileName', 'uploadedAt', 'status', 'appVersion',
               'latamConfirmed', 'summary', 'traits', 'traitsSource', 'nick', 'discord', 'notes'
             ])
             && d.keys().hasAll([
               'bytes', 'fileName', 'uploadedAt', 'status', 'appVersion',
               'latamConfirmed', 'summary'
             ])
             && d.status == 'new'
             && d.latamConfirmed == true
             // A Firestore document caps at 1 MiB; leave headroom for the rest.
             && d.bytes is bytes && d.bytes.size() > 0 && d.bytes.size() <= 921600
             && d.fileName is string && d.fileName.size() <= 200
             && d.appVersion is string && d.appVersion.size() <= 20
             && d.summary is map && d.summary.size() <= 24
             // Client clock, so only loosely checked — it exists to keep the
             // triage list in order, not to prove anything.
             && d.uploadedAt is timestamp
             && d.uploadedAt > request.time - duration.value(10, 'm')
             && d.uploadedAt < request.time + duration.value(10, 'm')
             && (!d.keys().hasAny(['traits']) || areTraits(d.traits))
             // Where the traits came from — off the recording, or typed into the
             // form. Only meaningful alongside them, so it travels with them.
             && (!d.keys().hasAny(['traitsSource'])
                 || (d.keys().hasAll(['traits']) && d.traitsSource in ['replay', 'form']))
             && (!d.keys().hasAny(['nick']) || (d.nick is string && d.nick.size() <= 40))
             && (!d.keys().hasAny(['discord']) || (d.discord is string && d.discord.size() <= 60))
             && (!d.keys().hasAny(['notes']) || (d.notes is string && d.notes.size() <= 1000));
    }

    // The six trait stats, as the *invested* value the calculator stores (0-100);
    // the job bonus is added on top by the engine, not recorded here.
    function areTraits(t) {
      return t is map
             && t.keys().hasOnly(['pow', 'sta', 'wis', 'spl', 'con', 'crt'])
             && t.keys().hasAll(['pow', 'sta', 'wis', 'spl', 'con', 'crt'])
             && isTrait(t.pow) && isTrait(t.sta) && isTrait(t.wis)
             && isTrait(t.spl) && isTrait(t.con) && isTrait(t.crt);
    }

    function isTrait(v) {
      return v is int && v >= 0 && v <= 100;
    }
  }
}
