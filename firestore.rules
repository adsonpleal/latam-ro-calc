rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Retired collection. The "Ajude o simulador" recordings now go to the shared
    // tracker (project `issues-latam-tools`, collection `gravacoes`), and the 24
    // that were here were migrated over keeping their ids. No client writes to
    // this project any more.
    //
    // The block stays, with everything denied: the documents remain here as
    // history, readable only with an admin credential, and not even a stale open
    // tab can write again. The format that existed is described in the
    // `triage-rrf-uploads` skill and in the git history — it is not worth keeping
    // the validator here just for that, because a dead rule is still compiled and
    // warned about on every deploy.
    //
    // Reads were always denied on purpose — that is why the submissions never sat
    // behind a guessable URL the way the RagnaRecap replays do. The tracker keeps
    // that property: `gravacoes` is admin-read-only, and a recording only reaches
    // the public board as a card that triage deliberately created from it.
    match /replay_submissions/{submissionId} {
      allow read, create, update, delete: if false;
    }
  }
}
