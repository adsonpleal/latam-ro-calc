# See http://help.github.com/ignore-files/ for more about ignoring files.

# Compiled output
/dist
# `wrangler dev` local state (asset cache, workerd scratch).
/.wrangler
/tmp
/out-tsc
/bazel-out

# Node
/node_modules
npm-debug.log
yarn-error.log

# IDEs and editors
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# Visual Studio Code
.vscode
.vscode/*
.history/*

# Miscellaneous
/.angular/cache
.sass-cache/
/connect.lock
/coverage
/libpeerconnection.log
testem.log
/typings

# System files
.DS_Store
Thumbs.db

# Secrets
.env
.env.local
# Local overrides for `wrangler dev` (e.g. OG_ORIGIN pointing at a local MCP server).
.dev.vars
# Service-account key for admin reads of the shared issue tracker. Nothing in the
# repo uses it any more (the skills reuse the `firebase login` token), but keep it
# ignored so a stray copy never gets committed.
.firebase-admin.json

# Downloads and dumps from the replay skills (.rrf files, decoded output).
/.scratch/

# Artefatos derivados de src/assets/demo/data/ (tools/build-web-data.mjs).
# Regerados por `pnpm data:dev` / `pnpm data:build`; ficam fora do git para não
# commitar vários MB a cada edição do item.json.
/src/assets/data/
/src/assets/data-manifest.json

# Reference dumps from the card scripts (tools/classify-missing-cards.mjs and
# tools/resolve-card-slots.mjs). Both are regenerated on demand from
# latam-items.json + item.json, and one of them is a RagnaPlace copy, so they
# stay local for reference instead of being committed.
/tools/data/

# Compiled files
layout.css
src/assets/demo/styles/badges.css
ssl
backup-preset.json